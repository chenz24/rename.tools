# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-reports

# next.js
/.next/
/out/
# Generated by scripts/build.mjs with the same release ID as Next.js.
/public/sw.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# cloudflare
.open-next
.wrangler

# typescript
*.tsbuildinfo
next-env.d.ts

# documentation
/docs/
